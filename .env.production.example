# luiproxyai production env — copy to .env.production on the server.
# DO NOT commit the real .env.production file.
#
#   cp .env.production.example .env.production && chmod 600 .env.production

# === Master Bearer key ===
# Clients send `Authorization: Bearer <key>` via OpenAI SDK.
# Generate: node -e "console.log('sk-gw-' + require('crypto').randomBytes(32).toString('hex'))"
GATEWAY_API_KEY=sk-gw-<generate-with-node-crypto-randomBytes-32-hex>

# === Secret-at-rest for provider API keys (REQUIRED in production) ===
# Provider keys entered in /setup are stored in the `api_keys` table. Without
# this variable src/lib/secret-vault.ts keeps them as PLAINTEXT rows; with it
# they are sealed as AES-256-GCM (`enc:v1:...`). Any passphrase >= 16 chars
# works — it is SHA-256'd into the 32-byte key.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Rotating this value makes every already-sealed key unreadable — re-enter
# them in /setup afterwards.
APP_ENCRYPTION_KEY=<generate-with-node-crypto-randomBytes-32-base64>

# === Admin identity ===
# Owner email(s) — Google-login admins. Comma / semicolon / space separated.
AUTH_OWNER_EMAIL=you@example.com

# === Admin login options (at least one recommended) ===

# (A) Google OAuth — optional but preferred for an audit trail.
#     Add callback {NEXTAUTH_URL}/api/auth/callback/google on Google Console.
#     NEXTAUTH_URL is the PUBLIC url of this gateway; it is deliberately not
#     set in docker-compose.prod.yml so it never lands in a tracked file.
NEXTAUTH_URL=https://gw.example.com
NEXTAUTH_SECRET=<generate-with-node-crypto-randomBytes-32-base64>
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# (B) Password login — for admins without a Google account / airgap access.
#     Mints a signed httpOnly cookie valid 7 days. Rate-limited.
#     Pick >= 20 random chars. Empty = password path disabled.
ADMIN_PASSWORD=<generate-with-node-crypto-randomBytes-24-base64>

# Signing key for that admin cookie. If left empty the cookie is signed with
# ADMIN_PASSWORD itself, so a leaked cookie can be brute-forced offline to
# recover the password (see src/lib/admin-cookie.ts:22). Always set it.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ADMIN_COOKIE_SECRET=<generate-with-node-crypto-randomBytes-32-base64>

# === Provider keys (managed from dashboard /setup, NOT env) ===
# Leave empty. The gateway reads provider API keys from the `api_keys` DB
# table populated by the Setup modal, sealed with APP_ENCRYPTION_KEY above.

# === Optional ops ===
# POSTed to on a >=20pp success-rate drop (Slack / Discord compatible body).
# GATEWAY_REGRESSION_WEBHOOK=
# Cloudflare account id — only needed if the Workers AI provider is enabled.
# CLOUDFLARE_ACCOUNT_ID=
# Set to 0 to keep user prompts out of gateway_logs.
# GATEWAY_LOG_PROMPTS=1

# === Cost policy ===
# Hardcoded no-spend mode. Runtime allowlist env vars are ignored.
# Routing is limited to the free catalog in `src/lib/free-model-catalog.ts`.
# Local/Ollama, provider-wide allowlists, router aliases, and paid overrides
# are disabled. Only add provider keys from no-card / no-billing accounts.
